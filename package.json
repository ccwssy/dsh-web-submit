{
  "name": "dsh-web-submit",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: run headless-style tasks through the running dsh web process via POST /x/headless, with status, health and SSE live-event endpoints — CLI-invoked runs are visible in the Web UI in real time.",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "headless",
    "web",
    "bridge",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
